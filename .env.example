# Copy to .env.local for local development (optional - the app runs without it).

# PostgreSQL connection string. Leave empty locally to use the built-in embedded database (./.pglite).
# Required on Vercel. Free option: https://neon.tech  (use the "pooled" connection string)
DATABASE_URL=

# Secret used to sign login sessions. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
